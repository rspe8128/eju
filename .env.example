# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채운다.
# DeepL 무료 플랜 키는 ":fx" 로 끝나며, 월 50만 자까지 무료다.
DEEPL_API_KEY=your-deepl-key-here:fx

# 記述(작문) AI 채점용 OpenRouter 키. https://openrouter.ai/keys 에서 발급한다.
OPENROUTER_API_KEY=sk-or-v1-...
# 선택. 비우면 anthropic/claude-sonnet-5 를 쓴다.
# 모델 슬러그는 수시로 바뀐다. 404가 나면 `npm run check:ai` 로 후보를 확인할 것.
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Supabase Auth/DB (로그인·프로필용)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# 서버 전용 (NEXT_PUBLIC 금지)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
